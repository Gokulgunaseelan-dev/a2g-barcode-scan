# Lovable Cloud / Supabase — client (safe to expose, publishable)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side (SSR / server functions). NEVER expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=your-project-ref
# SUPABASE_SERVICE_ROLE_KEY=  # server-only, keep out of the frontend and out of git
